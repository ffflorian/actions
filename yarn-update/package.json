{
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.1",
    "semver": "7.8.5"
  },
  "description": "GitHub Action which checks for yarn updates and creates a pull request",
  "devDependencies": {
    "@ffflorian/oxfmt-config": "1.2.1",
    "@types/node": "~26",
    "@types/semver": "7.8.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.70.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "name": "yarn-update-action",
  "packageManager": "yarn@4.18.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node26 --outfile=dist/index.js --minify",
    "fix": "oxfmt .",
    "lint": "oxfmt --check .",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "version": "1.0.0"
}
