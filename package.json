{
  "author": "Florian Imdahl <git@ffflorian.de>",
  "description": "A collection of GitHub Actions for use in my projects.",
  "devDependencies": {
    "@ffflorian/oxfmt-config": "1.3.0",
    "@nx/js": "23.3.0",
    "lefthook": "2.2.2",
    "nx": "23.3.0",
    "oxfmt": "0.73.0"
  },
  "license": "GPL-3.0",
  "name": "actions",
  "packageManager": "yarn@4.18.1",
  "private": true,
  "scripts": {
    "build": "nx run-many -t build",
    "fix": "yarn format",
    "format": "oxfmt .",
    "lint": "yarn format --check",
    "test": "nx run-many -t test",
    "type-check": "nx run-many -t type-check"
  },
  "type": "module",
  "workspaces": [
    "coolify-deploy",
    "force-release",
    "hugo-theme-update",
    "yarn-update"
  ]
}
