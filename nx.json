{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false,
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/package.json", "{workspaceRoot}/yarn.lock"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "cache": true
    },
    "type-check": {
      "cache": true
    }
  }
}
